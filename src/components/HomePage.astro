---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { translations, type Locale } from '../data/i18n';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = translations[lang];
const projectBase = lang === 'tr' ? '/projects' : `/${lang}/projects`;
---

<BaseLayout title={t.meta.title} description={t.meta.description} lang={lang} services={t.services.items}>
  <Header lang={lang} copy={t.nav} />
  <main id="top">
    <section class="hero">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="container hero-layout">
        <div class="hero-copy">
          <div class="eyebrow"><span></span> {t.hero.eyebrow}</div>
          <h1>{t.hero.line1}<br /><em>{t.hero.accent}</em><br />{t.hero.line3}</h1>
          <p>{t.hero.intro}</p>
          <div class="hero-actions"><a class="button button-primary" href="#contact">{t.hero.cta} <span aria-hidden="true">↗</span></a><a class="text-link" href="#projects">{t.hero.work} <span aria-hidden="true">↓</span></a></div>
        </div>
        <div class="hero-visual" aria-label={t.hero.aria}>
          <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
          <div class="visual-card card-main"><span class="card-kicker">sryya / studio</span><div class="signal"><i></i><i></i><i></i><i></i><i></i></div><strong>{t.hero.from}<br />{t.hero.launch}</strong><div class="card-footer"><span>01</span><span>{t.hero.disciplines}</span></div></div>
          <div class="visual-card card-small card-code"><span>{t.hero.performance}</span><strong>98</strong><small>/ 100</small></div>
          <div class="visual-card card-small card-status"><span class="status-dot"></span><strong>{t.hero.live}</strong><small>{t.hero.seamless}</small></div>
        </div>
      </div>
      <div class="container proof-row">{t.hero.proof.map((item) => <span>{item}</span>)}</div>
    </section>

    <section id="services" class="section services"><div class="container"><div class="section-heading split-heading"><div><span class="section-index">{t.services.index}</span><h2>{t.services.title1}<br />{t.services.title2}</h2></div><p>{t.services.intro}</p></div><div class="service-grid">{t.services.items.map((service) => <article class="service-card"><span>{service.no}</span><h3>{service.title}</h3><p>{service.text}</p><i aria-hidden="true">↗</i></article>)}</div></div></section>

    <section id="approach" class="section process"><div class="container process-layout"><div class="process-intro"><span class="section-index light">{t.approach.index}</span><h2>{t.approach.title1}<br />{t.approach.title2}</h2><p>{t.approach.intro}</p></div><div class="steps">{t.approach.steps.map((step) => <article class="step"><span>{step.no}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></article>)}</div></div></section>

    <section id="projects" class="section projects">
      <div class="container">
        <div class="section-heading split-heading project-heading">
          <div><span class="section-index">{t.projects.index}</span><h2>{t.projects.title}</h2></div>
          <p>{t.projects.intro}</p>
        </div>
        <div class="project-carousel" data-project-carousel>
          <div class="project-list" role="region" aria-label={t.projects.carouselLabel} tabindex="0" data-project-track>
            {t.projects.items.map((project, index) => (
              <article class:list={['project-feature', `project-${index + 1}`]} data-project-slide>
                <div class="project-copy">
                  <div><span class="project-type">{project.type}</span><h3>{project.name}</h3><p>{project.description}</p></div>
                  <div class="project-card-actions"><a href={`${projectBase}/${project.slug}/`}>{t.projects.visit} <span aria-hidden="true">↗</span></a>{!project.url && <span class="project-note">{project.note}</span>}</div>
                </div>
                <div class="project-art" aria-label={project.name}>
                  <div class="project-logo-wrap"><img src={project.logo} alt={`${project.name} logo`} width="700" height="700" loading="lazy" decoding="async" /></div>
                  <small class="project-art-note">{project.note}</small><div class="project-lines"><i></i><i></i><i></i></div>
                </div>
              </article>
            ))}
          </div>
          <div class="carousel-footer">
            <span class="carousel-count" aria-live="polite"><b data-project-current>01</b><i></i><span>{String(t.projects.items.length).padStart(2, '0')}</span></span>
            <div class="carousel-actions">
              <button type="button" aria-label={t.projects.previous} data-project-prev>←</button>
              <button type="button" aria-label={t.projects.next} data-project-next>→</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="about" class="section about"><div class="container about-layout"><div class="about-statement"><span class="section-index">{t.about.index}</span><h2>{t.about.title1}<br />{t.about.title2}</h2></div><div class="about-copy"><p class="lead">{t.about.lead}</p><p>{t.about.text}</p><div class="metrics">{t.about.metrics.map(([value, label]) => <div><strong>{value}</strong><span>{label}</span></div>)}</div></div></div></section>

    <section class="section testimonials" aria-labelledby="testimonials-title">
      <div class="container testimonial-heading">
        <div><span class="section-index light">{t.testimonials.index}</span><h2 id="testimonials-title">{t.testimonials.title}</h2></div>
        <p>{t.testimonials.intro}</p>
      </div>
      <div class="testimonial-track" role="region" aria-label={t.testimonials.label} tabindex="0">
        <div class="testimonial-spacer" aria-hidden="true"></div>
        {t.testimonials.items.map((item, index) => (
          <article class="testimonial-card">
            <div><span>{String(index + 1).padStart(2, '0')}</span><span aria-hidden="true">✦</span></div>
            <blockquote>“{item.quote}”</blockquote>
            <footer><strong>{item.role}</strong><span>{item.sector}</span></footer>
          </article>
        ))}
        <div class="testimonial-spacer" aria-hidden="true"></div>
      </div>
    </section>

    <section id="contact" class="contact"><div class="container contact-inner"><span class="section-index light">{t.contact.index}</span><h2>{t.contact.title}</h2><p>{t.contact.text}</p><a class="button button-light" href={`mailto:info@sryya.dev?subject=${encodeURIComponent(t.contact.subject)}`}>info@sryya.dev <span aria-hidden="true">↗</span></a></div></section>
  </main>
  <Footer lang={lang} copy={t.footer} />
</BaseLayout>

<script>
  document.querySelectorAll('[data-project-carousel]').forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>('[data-project-track]');
    const slides = [...carousel.querySelectorAll<HTMLElement>('[data-project-slide]')];
    const current = carousel.querySelector<HTMLElement>('[data-project-current]');
    const previous = carousel.querySelector<HTMLButtonElement>('[data-project-prev]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-project-next]');
    if (!track || !slides.length) return;

    let activeIndex = 0;
    let scrollFrame = 0;
    let pointerStart = 0;
    let scrollStart = 0;
    let dragging = false;

    const setActive = (index: number) => {
      activeIndex = Math.max(0, Math.min(slides.length - 1, index));
      if (current) current.textContent = String(activeIndex + 1).padStart(2, '0');
      if (previous) previous.disabled = activeIndex === 0;
      if (next) next.disabled = activeIndex === slides.length - 1;
    };

    const goTo = (index: number) => {
      const target = Math.max(0, Math.min(slides.length - 1, index));
      track.scrollTo({ left: slides[target].offsetLeft - track.offsetLeft, behavior: 'smooth' });
      setActive(target);
    };

    track.addEventListener('scroll', () => {
      cancelAnimationFrame(scrollFrame);
      scrollFrame = requestAnimationFrame(() => {
        const nearest = slides.reduce((best, slide, index) => Math.abs(slide.offsetLeft - track.offsetLeft - track.scrollLeft) < Math.abs(slides[best].offsetLeft - track.offsetLeft - track.scrollLeft) ? index : best, 0);
        setActive(nearest);
      });
    }, { passive: true });

    previous?.addEventListener('click', () => goTo(activeIndex - 1));
    next?.addEventListener('click', () => goTo(activeIndex + 1));
    track.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') { event.preventDefault(); goTo(activeIndex - 1); }
      if (event.key === 'ArrowRight') { event.preventDefault(); goTo(activeIndex + 1); }
    });

    track.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'touch') return;
      if (event.target instanceof Element && event.target.closest('a, button')) return;
      pointerStart = event.clientX;
      scrollStart = track.scrollLeft;
      dragging = true;
      track.classList.add('is-dragging');
      track.setPointerCapture(event.pointerId);
    });
    track.addEventListener('pointermove', (event) => {
      if (!dragging) return;
      track.scrollLeft = scrollStart - (event.clientX - pointerStart);
    });
    const stopDragging = (event: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      track.classList.remove('is-dragging');
      if (track.hasPointerCapture(event.pointerId)) track.releasePointerCapture(event.pointerId);
      goTo(activeIndex);
    };
    track.addEventListener('pointerup', stopDragging);
    track.addEventListener('pointercancel', stopDragging);
    setActive(0);
  });
</script>
