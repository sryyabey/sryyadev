---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang: 'tr' | 'en' | 'ru';
  services: Array<{ title: string; text: string }>;
  path?: string;
  noindex?: boolean;
}

const { title, description, lang, services, path = '', noindex = false } = Astro.props;
const normalizedPath = path.replace(/^\/+|\/+$/g, '');
const localizedPath = lang === 'tr' ? normalizedPath : [lang, normalizedPath].filter(Boolean).join('/');
const canonical = `https://sryya.dev/${localizedPath ? `${localizedPath}/` : ''}`;
const alternateUrl = (targetLang: 'tr' | 'en' | 'ru') => {
  const targetPath = targetLang === 'tr' ? normalizedPath : [targetLang, normalizedPath].filter(Boolean).join('/');
  return `https://sryya.dev/${targetPath ? `${targetPath}/` : ''}`;
};
const locale = { tr: 'tr_TR', en: 'en_US', ru: 'ru_RU' }[lang];
const alternateLocales = ['tr_TR', 'en_US', 'ru_RU'].filter((item) => item !== locale);
const imageAlt = {
  tr: 'sryya.dev dijital ürün ve yazılım geliştirme stüdyosu',
  en: 'sryya.dev digital product and software development studio',
  ru: 'sryya.dev — студия разработки цифровых продуктов',
}[lang];
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://sryya.dev/#organization',
      name: 'sryya.dev',
      url: 'https://sryya.dev/',
      logo: 'https://sryya.dev/sryyadev-logo.png',
      email: 'info@sryya.dev',
      description,
      knowsLanguage: ['tr', 'en', 'ru'],
      contactPoint: {
        '@type': 'ContactPoint',
        email: 'info@sryya.dev',
        contactType: 'sales',
        availableLanguage: ['Turkish', 'English', 'Russian'],
      },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: title,
        itemListElement: services.map((service) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: service.title, description: service.text },
        })),
      },
    },
    {
      '@type': 'WebSite',
      '@id': 'https://sryya.dev/#website',
      url: 'https://sryya.dev/',
      name: 'sryya.dev',
      description,
      inLanguage: ['tr', 'en', 'ru'],
      publisher: { '@id': 'https://sryya.dev/#organization' },
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="author" content="sryya.dev" />
    <meta name="generator" content={Astro.generator} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#07111f" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="sryya.dev" />
    <meta property="og:locale" content={locale} />
    {alternateLocales.map((alternate) => <meta property="og:locale:alternate" content={alternate} />)}
    <meta property="og:image" content="https://sryya.dev/og.png" />
    <meta property="og:image:width" content="1731" />
    <meta property="og:image:height" content="909" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://sryya.dev/og.png" />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="alternate" hreflang="tr" href={alternateUrl('tr')} />
    <link rel="alternate" hreflang="en" href={alternateUrl('en')} />
    <link rel="alternate" hreflang="ru" href={alternateUrl('ru')} />
    <link rel="alternate" hreflang="x-default" href={alternateUrl('tr')} />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body>
    <slot />
  </body>
</html>
